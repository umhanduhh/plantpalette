# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# USDA FoodData Central — used client-side by the manual food search
NEXT_PUBLIC_USDA_API_KEY=

# Photo food logging (server-side only — never exposed to the browser)
# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# FoodData Central API key, from https://api.data.gov/signup
# Can be the same key as NEXT_PUBLIC_USDA_API_KEY above; kept as a separate
# env var so it's never bundled into client-side code.
FDC_API_KEY=
